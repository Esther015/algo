// Programme principal
// ============================================
int main() {
    P1();
    P2();
    
    // Libérer la mémoire
    if (Picture != nullptr) {
        for (int i = 0; i < current_n; i++) {
            delete[] Picture[i];
        }
        delete[] Picture;
    }
    
    return 0;
}
