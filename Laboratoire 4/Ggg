#include <iostream>
#include <cstdlib>
#include <ctime>
using namespace std;

long long counter = 0;

void quickSort(int a[], int left, int right)
{
    int i = left;
    int j = right;
    int pivot = a[(left + right) / 2];
    counter++;

    while (i <= j)
    {
        while (a[i] < pivot)
        {
            i++;
            counter++;
        }

        while (a[j] > pivot)
        {
            j--;
            counter++;
        }

        if (i <= j)
        {
            int temp = a[i];
            a[i] = a[j];
            a[j] = temp;

            i++;
            j--;
            counter++;
        }
    }

    if (left < j)
        quickSort(a, left, j);

    if (i < right)
        quickSort(a, i, right);
}

int main()
{
    srand(time(0));

    const int MAX = 10000;
    int a[MAX];

    cout << "n Tmin Tmean Tmax" << endl;

    for(int n = 100; n <= 10000; n += 100)
    {
        long long Tmin = 0;
        long long Tmax = 0;
        long long sum = 0;

        // ---------- Tmin ----------
        for(int i = 0; i < n; i++)
            a[i] = rand() % 100000;

        counter = 0;
        quickSort(a, 0, n-1);
        Tmin = counter;

        // ---------- Tmax ----------
        for(int i = 0; i < n; i++)
            a[i] = i;   // tableau trié (pire cas)

        counter = 0;
        quickSort(a, 0, n-1);
        Tmax = counter;

        // ---------- Tmean ----------
        for(int k = 0; k < 1000; k++)
        {
            for(int i = 0; i < n; i++)
                a[i] = rand() % 100000;

            counter = 0;
            quickSort(a, 0, n-1);

            sum += counter;
        }

        double Tmean = (double)sum / 1000;

        cout << n << " " << Tmin << " " << Tmean << " " << Tmax << endl;
    }

    return 0;
}
