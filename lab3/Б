#include <iostream>
#include <vector>
#include <random>
#include <cmath>
#include <fstream>
#include <iomanip>

using namespace std;

const short blanc = 0;
const short noir = 1;

const int max_n = 1000;
const int min_n = 100;
const int pas = 100;

const int nb_ex_par_n = 10;

struct ImageRect {
    int x1, y1;
    int x2, y2;
};

short** picture = nullptr;
bool** visited = nullptr;

int current_n = 0;
long long operations = 0;

void allouerPicture(int n)
{
    if (picture != nullptr)
    {
        for (int i = 0; i < current_n; i++)
        {
            delete[] picture[i];
            delete[] visited[i];
        }

        delete[] picture;
        delete[] visited;
    }

    picture = new short* [n];
    visited = new bool* [n];

    for (int i = 0; i < n; i++)
    {
        picture[i] = new short[n];
        visited[i] = new bool[n];
    }

    current_n = n;
}

void iniblanc(int n)
{
    for (int i = 0; i < n; i++)
        for (int j = 0; j < n; j++)
        {
            picture[i][j] = blanc;
            visited[i][j] = false;
        }
}

void F(int x, int y, int taille)
{
    int epaisseur = max(1, taille / 8);
    int largeur = taille / 3;
    int hauteur = taille;

    for (int i = 0; i < hauteur; i++)
        for (int e = 0; e < epaisseur; e++)
        {
            int px = x + largeur + e;
            int py = y + i;

            if (px >= 0 && px < current_n && py >= 0 && py < current_n)
                picture[px][py] = noir;
        }

    int rayon = largeur * 2;

    for (int r = 0; r <= rayon; r++)
    {
        int py = y + r;

        for (int e = 0; e < epaisseur; e++)
            for (int dx = 0; dx <= largeur; dx++)
            {
                int px = x + dx + e;

                if (px >= 0 && px < current_n && py >= 0 && py < current_n)
                    if (dx <= rayon - r)
                        picture[px][y] = noir;
            }
    }
}

// DFS pour explorer l'image
void DFS(int x, int y, ImageRect& rect)
{
    if (x < 0 || y < 0 || x >= current_n || y >= current_n)
        return;

    operations++;

    if (visited[x][y] || picture[x][y] == blanc)
        return;

    visited[x][y] = true;

    rect.x1 = min(rect.x1, x);
    rect.y1 = min(rect.y1, y);
    rect.x2 = max(rect.x2, x);
    rect.y2 = max(rect.y2, y);

    DFS(x + 1, y, rect);
    DFS(x - 1, y, rect);
    DFS(x, y + 1, rect);
    DFS(x, y - 1, rect);

    DFS(x + 1, y + 1, rect);
    DFS(x - 1, y - 1, rect);
    DFS(x + 1, y - 1, rect);
    DFS(x - 1, y + 1, rect);
}

// Fonction S de recherche
vector<ImageRect> S()
{
    vector<ImageRect> images;

    for (int i = 0; i < current_n; i++)
        for (int j = 0; j < current_n; j++)
        {
            operations++;

            if (picture[i][j] == noir && !visited[i][j])
            {
                ImageRect rect;
                rect.x1 = rect.x2 = i;
                rect.y1 = rect.y2 = j;

                DFS(i, j, rect);

                images.push_back(rect);
            }
        }

    return images;
}

// Génération aléatoire d'images
void genererImages(int n)
{
    int nb = 1 + rand() % 5;

    for (int i = 0; i < nb; i++)
    {
        int x = rand() % (n - 30);
        int y = rand() % (n - 30);

        F(x, y, 20);
    }
}

// PROGRAMME P1
void P1()
{
    cout << "Programme P1\n";

    allouerPicture(50);
    iniblanc(50);

    F(5, 5, 20);
    F(25, 10, 15);

    vector<ImageRect> images = S();

    if (images.empty())
        cout << "ne contient pas\n";
    else
    {
        for (auto& r : images)
        {
            cout << "Image: ";
            cout << "(" << r.x1 << "," << r.y1 << ") ";
            cout << "(" << r.x2 << "," << r.y2 << ")\n";
        }
    }
}

// PROGRAMME P2
void P2()
{
    ofstream fout("results.txt");

    for (int n = min_n; n <= max_n; n += pas)
    {
        long long somme = 0;

        for (int k = 0; k < nb_ex_par_n; k++)
        {
            allouerPicture(n);
            iniblanc(n);

            genererImages(n);

            operations = 0;

            S();

            somme += operations;
        }

        double T = (double)somme / nb_ex_par_n;

        fout << n << " " << T << endl;

        cout << "n=" << n << " T(n)=" << T << endl;
    }

    fout.close();
}

int main()
{
    srand(time(0));

    P1();

    cout << "\n--- Experiments ---\n";

    P2();

    return 0;
}
