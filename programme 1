#include <iostream>
#include <vector>
using namespace std;

int main() {
	int n = 5;


	int A[100][100];
	int B[100], C[100];

	cout << "Remplissage de la matrice " << endl;
	for (int i = 0; i < n; i++) {
		for (int j = 0; j < n; j++)
			cin >> A[i][j];
	}
	cout << "Remplissage du vecteur " << endl;
	for (int i = 0; i < n; i++) {
		for (int j = 0; j < n; j++)
			cin >> B[i];
	}
	for (int i = 0; i < n; i++) {
		C[i] = 0;
		for (int j = 0; j < n ;j++)
			C[i] += A[i][j] * B[j]; 
	}
	cout << "Resultat" << endl;
	for (int i = 0; i < n; i++) {
		cout << C[i] << " "; 
	}
}
