#include <iostream>
#include <fstream>
using namespace std;

long long compteur;

void bubble_sort(int A[], int n) {
	compteur = 0;
	for (int i = 0; i < n - 1; i++) {
		for (int j = 0; j < n - i - 1; j++) {
			compteur++;

			if (A[j] > A[j + 1]) {
				int temp = A[j];
				A[j] = A[j + 1];
				A[j + 1] = temp;
				compteur += 3;
			}
		}
	}
	cout << "Compteur= "<<compteur << endl;
}

