// PROGRAMME P2
void P2()
{
    ofstream fout("results.txt");

    for (int n = min_n; n <= max_n; n += pas)
    {
        long long somme = 0;

        for (int k = 0; k < nb_ex_par_n; k++)
        {
            allouerPicture(n);
            iniblanc(n);

            genererImages(n);

            operations = 0;

            S();

            somme += operations;
        }

        double T = (double)somme / nb_ex_par_n;

        fout << n << " " << T << endl;

        cout << "n=" << n << " T(n)=" << T << endl;
    }

    fout.close();
}

