#include <iostream>
#include <cmath>
using namespace std;

double erf_taylor(double x) {
    const double PI = acos(-1.0);
    const double coef = 2.0 /sqrt (PI);

    double somme = 0.0;
    double terme = x;
    int n = 0;

    while (somme + terme != somme) {
        somme += terme;
        n++;
        terme *= -x * x / (n * (2 * n + 1));
    }
    return coef * somme;
}

