#include <iostream>
#include <vector>
#include <cstdlib>
#include <ctime>
#include <cmath>
#include <fstream>

using namespace std;

long long operations; // Compteur global d'opérations

// Partition de Hoare
int partition(int arr[], int low, int high) {
    int pivot = arr[low];
    int i = low - 1;
    int j = high + 1;
    
    while (true) {
        do {
            i++;
            operations++; // Comparaison
        } while (arr[i] < pivot);
        
        do {
            j--;
            operations++; // Comparaison
        } while (arr[j] > pivot);
        
        if (i >= j) return j;
        
        // Échange
        swap(arr[i], arr[j]);
        operations += 3; // 3 affectations pour l'échange
    }
}

// Tri rapide
void quickSort(int arr[], int low, int high) {
    if (low < high) {
        int pi = partition(arr, low, high);
        quickSort(arr, low, pi);
        quickSort(arr, pi + 1, high);
    }
}

// Initialisation pour Tmin (déjà trié)
void initMin(int arr[], int n) {
    for (int i = 0; i < n; i++)
        arr[i] = i;
}

// Initialisation pour Tmax (trié inverse)
void initMax(int arr[], int n) {
    for (int i = 0; i < n; i++)
        arr[i] = n - i;
}

// Initialisation pour Tmean (aléatoire)
void initRandom(int arr[], int n) {
    for (int i = 0; i < n; i++)
        arr[i] = rand() % (10 * n);
}

int main() {
    srand(time(NULL));
    ofstream fmin("min.txt"), fmean("mean.txt"), fmax("max.txt");
    
    // Pour Tmin et Tmax : une mesure par n
    // Pour Tmean : moyenne sur 1000 mesures
    
    for (int n = 100; n <= 10000; n += 100) {
        
        // --- Cas minimum ---
        int* arr = new int[n];
        initMin(arr, n);
        operations = 0;
        quickSort(arr, 0, n-1);
        fmin << n << " " << operations << endl;
        
        // --- Cas maximum ---
        initMax(arr, n);
        operations = 0;
        quickSort(arr, 0, n-1);
        fmax << n << " " << operations << endl;
        
        // --- Cas moyen ---
        long long totalOps = 0;
        for (int k = 0; k < 1000; k++) {
            initRandom(arr, n);
            operations = 0;
            quickSort(arr, 0, n-1);
            totalOps += operations;
        }
        fmean << n << " " << (totalOps / 1000.0) << endl;
        
        delete[] arr;
    }
    
    fmin.close();
    fmean.close();
    fmax.close();
    return 0;
}
