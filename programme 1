#include <iostream>
#include <vector>
using namespace std;

int main() {
	int n = 5;


	int A[100][100];
	int B[100], C[100];

	for (int i = 0; i < n; i++) {
		B[i] = i + 1;
		for (int j = 0; j < n; j++)
			A[i][j] = j + 1;
	}

	for (int i = 0; i < n; i++) {
		C[i] = 0;
		for (int j = 0; j < n ;j++)
			C[i] += A[i][j] * B[j]; 
	}

	for (int i = 0; i < n; i++) {
		cout << C[i] << " "; 
	}
}
