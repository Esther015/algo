#include <iostream>
#include <vector>
#include <random>
#include <fstream>
#include <cmath>
#include <iomanip>

using namespace std;

// Constantes
const short BLANC = 0;
const short NOIR = 1;
const int MAX_N = 1000;
const int MIN_N = 100;
const int PAS = 100;
const int NB_EXP_PAR_N = 10; // Nombre d'expériences par valeur de n

// Structure pour stocker les coordonnées d'une image trouvée
struct ImageRect {
    int x1, y1; // Coin supérieur gauche
    int x2, y2; // Coin inférieur droit
};

// Variables globales
short** Picture = nullptr;
int current_n = 0;
long long operations = 0;

// Fonction pour allouer la matrice
void allouerPicture(int n) {
    if (Picture != nullptr) {
        for (int i = 0; i < current_n; i++) {
            delete[] Picture[i];
        }
        delete[] Picture;
    }
    
    Picture = new short*[n];
    for (int i = 0; i < n; i++) {
        Picture[i] = new short[n];
    }
    current_n = n;
}

// Fonction pour initialiser à blanc
void initBlanc(int n) {
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            Picture[i][j] = BLANC;
        }
    }
}

// ============================================
// FONCTION F : Crée une image (lettre 'A' stylisée)
// ============================================
void F(int x, int y, int taille) {
    // Dessine un 'A' stylisé avec des segments à 0°, 45° et 90°
    // Structure: /-\ avec une barre horizontale au milieu
    // et une barre verticale au centre
    
    // Segment gauche (diagonale montante) - 45°
    for (int i = 0; i < taille; i++) {
        int px = x + i;
        int py = y + taille - 1 - i;
        if (px >= 0 && px < current_n && py >= 0 && py < current_n) {
            Picture[px][py] = NOIR;
        }
    }
    
    // Segment droit (diagonale descendante) - -45°
    for (int i = 0; i < taille; i++) {
        int px = x + i;
        int py = y + i;
        if (px >= 0 && px < current_n && py >= 0 && py < current_n) {
            Picture[px][py] = NOIR;
        }
    }
    
    // Barre horizontale au milieu - 0°
    int milieu = y + taille / 2;
    for (int i = 0; i < taille; i++) {
        int px = x + i;
        int py = milieu;
        if (px >= 0 && px < current_n && py >= 0 && py < current_n) {
            Picture[px][py] = NOIR;
        }
    }
    
    // Barre verticale centrale - 90°
    int centre = x + taille / 2;
    for (int i = 0; i < taille; i++) {
        int px = centre;
        int py = y + i;
        if (px >= 0 && px < current_n && py >= 0 && py < current_n) {
            Picture[px][py] = NOIR;
        }
    }
}

// ============================================
// FONCTION S : Recherche les images
// ============================================
vector<ImageRect> S() {
    vector<ImageRect> resultats;
    operations = 0;
    
    // Matrice pour marquer les pixels visités
    vector<vector<bool>> visite(current_n, vector<bool>(current_n, false));
    
    // Parcours de toute l'image
    for (int i = 0; i < current_n; i++) {
        for (int j = 0; j < current_n; j++) {
            operations += 2; // Comparaisons dans les boucles
            
            if (Picture[i][j] == NOIR && !visite[i][j]) {
                operations++; // Comparaison
                
                // Trouvé un nouveau composant - BFS pour trouver tout l'objet
                int x_min = i, x_max = i, y_min = j, y_max = j;
                vector<pair<int, int>> pile;
                pile.push_back({i, j});
                visite[i][j] = true;
                
                while (!pile.empty()) {
                    operations++; // Vérification pile vide
                    
                    auto [x, y] = pile.back();
                    pile.pop_back();
                    operations += 2; // Accès aux éléments
                    
                    // Mise à jour des limites
                    if (x < x_min) x_min = x;
                    if (x > x_max) x_max = x;
                    if (y < y_min) y_min = y;
                    if (y > y_max) y_max = y;
                    operations += 4; // 4 comparaisons
                    
                    // Vérifier les 8 voisins (connexité 8)
                    for (int dx = -1; dx <= 1; dx++) {
                        for (int dy = -1; dy <= 1; dy++) {
                            operations += 2; // Incrémentations
                            
                            if (dx == 0 && dy == 0) continue;
                            operations++; // Comparaison
                            
                            int nx = x + dx;
                            int ny = y + dy;
                            operations += 2; // Additions
                            
                            if (nx >= 0 && nx < current_n && ny >= 0 && ny < current_n) {
                                operations += 4; // 4 comparaisons
                                
                                if (Picture[nx][ny] == NOIR && !visite[nx][ny]) {
                                    operations += 2; // Comparaisons
                                    pile.push_back({nx, ny});
                                    visite[nx][ny] = true;
                                    operations += 2; // Push et assignation
                                }
                            }
                        }
                    }
                }
                
                // Ajouter le rectangle trouvé
                resultats.push_back({x_min, y_min, x_max, y_max});
                operations += 7; // Construction de l'objet et push
            }
        }
    }
    
    return resultats;
}

// ============================================
// PROGRAMME P1 : Test
// ============================================
void P1() {
    cout << "=== PROGRAMME P1 : TEST ===" << endl;
    
    allouerPicture(50);
    initBlanc(50);
    
    // Placer quelques images
    F(5, 5, 8);
    F(20, 30, 10);
    F(35, 10, 6);
    
    // Rechercher
    vector<ImageRect> images = S();
    
    // Afficher les résultats
    cout << "Images trouvées : " << images.size() << endl;
    for (size_t i = 0; i < images.size(); i++) {
        cout << "Image " << i+1 << " : ("
             << images[i].x1 << "," << images[i].y1 << ") - ("
             << images[i].x2 << "," << images[i].y2 << ")" << endl;
    }
    cout << "Nombre d'opérations : " << operations << endl;
}

// ============================================
// PROGRAMME P2 : Mesure de complexité
// ============================================
void P2() {
    cout << "\n=== PROGRAMME P2 : MESURE DE COMPLEXITÉ ===" << endl;
    
    vector<int> tailles;
    vector<double> T_moyen;
    
    // Générateur aléatoire
    random_device rd;
    mt19937 gen(rd());
    uniform_int_distribution<> distrib_pos(0, 999);
    
    for (int n = MIN_N; n <= MAX_N; n += PAS) {
        allouerPicture(n);
        long long somme_ops = 0;
        
        for (int k = 0; k < NB_EXP_PAR_N; k++) {
            initBlanc(n);
            
            // Placer aléatoirement 5 images sans chevauchement
            vector<ImageRect> placed;
            int tentatives = 0;
            const int MAX_TENTATIVES = 1000;
            
            while (placed.size() < 5 && tentatives < MAX_TENTATIVES) {
                tentatives++;
                int x = distrib_pos(gen) % (n - 15);
                int y = distrib_pos(gen) % (n - 15);
                int taille = 8 + (gen() % 5); // Taille entre 8 et 12
                
                // Vérifier chevauchement avec images déjà placées
                bool chevauche = false;
                for (const auto& img : placed) {
                    if (!(x + taille < img.x1 || x > img.x2 || 
                          y + taille < img.y1 || y > img.y2)) {
                        chevauche = true;
                        break;
                    }
                }
                
                if (!chevauche) {
                    F(x, y, taille);
                    placed.push_back({x, y, x+taille-1, y+taille-1});
                }
            }
            
            // Rechercher et compter les opérations
            S();
            somme_ops += operations;
        }
        
        double moyenne = static_cast<double>(somme_ops) / NB_EXP_PAR_N;
        tailles.push_back(n);
        T_moyen.push_back(moyenne);
        
        cout << "n = " << n << " : T(n) moyen = " << moyenne << endl;
    }
    
    // Sauvegarder les données pour le graphique
    ofstream fichier("donnees_complexite.txt");
    for (size_t i = 0; i < tailles.size(); i++) {
        fichier << tailles[i] << " " << T_moyen[i] << endl;
    }
    fichier.close();
    
    // Trouver la formule par méthode des coefficients indéterminés
    if (tailles.size() >= 4) {
        // Prendre 4 points pour déterminer le polynôme de degré 3
        vector<int> indices = {0, 2, 4, 6}; // n=100, 300, 500, 700
        if (tailles.size() > 7) indices = {0, 2, 4, 7}; // n=100, 300, 500, 800
        
        double n0 = tailles[indices[0]];
        double n1 = tailles[indices[1]];
        double n2 = tailles[indices[2]];
        double n3 = tailles[indices[3]];
        
        double y0 = T_moyen[indices[0]];
        double y1 = T_moyen[indices[1]];
        double y2 = T_moyen[indices[2]];
        double y3 = T_moyen[indices[3]];
        
        // Résolution du système d'équations
        // k0 + k1*n + k2*n^2 + k3*n^3 = y
        
        // Construction de la matrice
        double A[4][4] = {
            {1, n0, n0*n0, n0*n0*n0},
            {1, n1, n1*n1, n1*n1*n1},
            {1, n2, n2*n2, n2*n2*n2},
            {1, n3, n3*n3, n3*n3*n3}
        };
        
        double B[4] = {y0, y1, y2, y3};
        double K[4] = {0};
        
        // Méthode de Gauss (simplifiée pour 4 équations)
        for (int i = 0; i < 4; i++) {
            // Normaliser la ligne i
            double pivot = A[i][i];
            for (int j = i; j < 4; j++) {
                A[i][j] /= pivot;
            }
            B[i] /= pivot;
            
            // Éliminer dans les lignes suivantes
            for (int k = i+1; k < 4; k++) {
                double facteur = A[k][i];
                for (int j = i; j < 4; j++) {
                    A[k][j] -= facteur * A[i][j];
                }
                B[k] -= facteur * B[i];
            }
        }
        
        // Remontée
        for (int i = 3; i >= 0; i--) {
            K[i] = B[i];
            for (int j = i+1; j < 4; j++) {
                K[i] -= A[i][j] * K[j];
            }
        }
        
        cout << "\nFormule trouvée par méthode des coefficients indéterminés:" << endl;
        cout << "T(n) = " << K[0];
        if (abs(K[1]) > 1e-10) cout << " + " << K[1] << "*n";
        if (abs(K[2]) > 1e-10) cout << " + " << K[2] << "*n^2";
        if (abs(K[3]) > 1e-10) cout << " + " << K[3] << "*n^3";
        cout << endl;
        
        if (abs(K[3]) < 1e-10) {
            cout << "Note: Le coefficient du terme n^3 est presque nul, la complexité semble quadratique." << endl;
        }
    }
}

