#include <iostream>
#void DFS(int x, int y, ImageRect& rect)
{
    if (x < 0 || y < 0 || x >= current_n || y >= current_n)
        return;

    operations++;

    if (visited[x][y] || picture[x][y] == blanc)
        return;

    visited[x][y] = true;

    rect.x1 = min(rect.x1, x);
    rect.y1 = min(rect.y1, y);
    rect.x2 = max(rect.x2, x);
    rect.y2 = max(rect.y2, y);

    DFS(x + 1, y, rect);
    DFS(x - 1, y, rect);
    DFS(x, y + 1, rect);
    DFS(x, y - 1, rect);

    DFS(x + 1, y + 1, rect);
    DFS(x - 1, y - 1, rect);
    DFS(x + 1, y - 1, rect);
    DFS(x - 1, y + 1, rect);
}

// Fonction S de recherche
vector<ImageRect> S()
{
    vector<ImageRect> images;

    for (int i = 0; i < current_n; i++)
        for (int j = 0; j < current_n; j++)
        {
            operations++;

            if (picture[i][j] == noir && !visited[i][j])
            {
                ImageRect rect;
                rect.x1 = rect.x2 = i;
                rect.y1 = rect.y2 = j;

                DFS(i, j, rect);

                images.push_back(rect);
            }
        }

    return images;
}

// Génération aléatoire d'images
void genererImages(int n)
{
    int nb = 1 + rand() % 5;

    for (int i = 0; i < nb; i++)
    {
        int x = rand() % (n - 30);
        int y = rand() % (n - 30);

        F(x, y, 20);
    }
}

